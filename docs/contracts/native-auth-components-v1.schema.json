{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://get-hermes.ai/contracts/native-auth-components-v1.schema.json",
  "title": "Semreh native authentication components v1",
  "description": "Strict model-facing metadata contract for browser-issued native authentication components. Secret material is represented only by an opaque encrypted envelope.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/authContext" },
    { "$ref": "#/$defs/nativeComponent" },
    { "$ref": "#/$defs/nativeComponentState" },
    { "$ref": "#/$defs/nativeSecretEnvelope" }
  ],
  "$defs": {
    "opaqueHandle": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9._~-]*$",
      "description": "Opaque, non-secret handle. It is not a selector, URL, credential, or user-entered value."
    },
    "safeLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,_'():+/-]*$",
      "description": "Short display/accessibility label with no markup, control characters, or executable syntax."
    },
    "providerOrigin": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+(?:\\:[1-9][0-9]{0,4})?$",
      "allOf": [
        { "not": { "pattern": ":443$" } }
      ],
      "description": "Canonical HTTPS origin: lowercase DNS name, optional non-default port, and no trailing slash, path, query, fragment, userinfo, or credentials."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^/(?:[A-Za-z0-9._~!$&'()*+,;=:@/-]*)$",
      "description": "Path-only request location. Query strings and fragments are intentionally not representable."
    },
    "componentKind": {
      "type": "string",
      "enum": [
        "identifier",
        "secret",
        "one_time_code",
        "recovery_code",
        "submit",
        "sso_continue",
        "email_magic_link",
        "phone_verification",
        "passkey",
        "security_key",
        "captcha",
        "push_approval",
        "device_approval",
        "cancel"
      ]
    },
    "expiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "description": "UTC expiry timestamp. This is metadata, not a protocol state or credential."
    },
    "componentIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueHandle" }
    },
    "actionHandles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueHandle" }
    },
    "targetRef": {
      "description": "Exact browser-issued locator. The model and page are not allowed to create or mutate this object.",
      "oneOf": [
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "selector"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "css" },
            "selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160,
              "pattern": "^[A-Za-z0-9_.#][A-Za-z0-9_.#:\\[\\]= '()>+~,*()\\-]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "selector"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "xpath" },
            "selector": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^//[A-Za-z0-9_.*@=\\[\\]\"' /-]{1,158}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "role", "label"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "role" },
            "role": {
              "type": "string",
              "enum": ["textbox", "button", "link", "combobox", "checkbox", "radio", "image", "option", "menuitem", "switch"]
            },
            "label": { "$ref": "#/$defs/safeLabel" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "label"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "label" },
            "label": { "$ref": "#/$defs/safeLabel" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "frame_handle"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "frame" },
            "frame_handle": { "$ref": "#/$defs/opaqueHandle" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "cdp_handle"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "cdp" },
            "cdp_handle": { "$ref": "#/$defs/opaqueHandle" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["issued_by", "immutable", "ref_id", "strategy", "locator_handle"],
          "properties": {
            "issued_by": { "const": "browser" },
            "immutable": { "const": true },
            "ref_id": { "$ref": "#/$defs/opaqueHandle" },
            "strategy": { "const": "playwright" },
            "locator_handle": { "$ref": "#/$defs/opaqueHandle" }
          },
          "additionalProperties": false
        }
      ]
    },
    "browserBinding": {
      "type": "object",
      "required": [
        "issued_by",
        "immutable",
        "tab_handle",
        "frame_handle",
        "document_generation",
        "visibility",
        "editability",
        "match_count",
        "target_ref"
      ],
      "properties": {
        "issued_by": { "const": "browser" },
        "immutable": { "const": true },
        "tab_handle": { "$ref": "#/$defs/opaqueHandle" },
        "frame_handle": { "$ref": "#/$defs/opaqueHandle" },
        "document_generation": { "$ref": "#/$defs/opaqueHandle" },
        "visibility": { "const": "visible" },
        "editability": { "enum": ["editable", "not_editable"] },
        "match_count": { "const": 1 },
        "target_ref": { "$ref": "#/$defs/targetRef" }
      },
      "additionalProperties": false
    },
    "browserFlow": {
      "type": "object",
      "required": ["owner", "flow_kind", "phase", "flow_handle"],
      "properties": {
        "owner": { "const": "browser" },
        "flow_kind": { "enum": ["oidc", "passkey", "captcha"] },
        "phase": {
          "enum": ["awaiting_redirect", "awaiting_user", "awaiting_challenge", "approved", "completed", "blocked"]
        },
        "flow_handle": { "$ref": "#/$defs/opaqueHandle" }
      },
      "additionalProperties": false
    },
    "authContext": {
      "type": "object",
      "required": [
        "type",
        "issued_by",
        "immutable",
        "context_id",
        "browser_session_id",
        "provider_origin",
        "path",
        "label",
        "component_ids",
        "action_handles"
      ],
      "properties": {
        "type": { "const": "hermes.auth-context.v1" },
        "issued_by": { "const": "browser" },
        "immutable": { "const": true },
        "context_id": { "$ref": "#/$defs/opaqueHandle" },
        "browser_session_id": { "$ref": "#/$defs/opaqueHandle" },
        "provider_origin": { "$ref": "#/$defs/providerOrigin" },
        "path": { "$ref": "#/$defs/path" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "component_ids": { "$ref": "#/$defs/componentIds" },
        "action_handles": { "$ref": "#/$defs/actionHandles" },
        "runtime_public_key": { "type": "string", "minLength": 32, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
        "key_id": { "$ref": "#/$defs/opaqueHandle" },
        "expires_at": { "$ref": "#/$defs/expiresAt" }
      },
      "additionalProperties": false
    },
    "nativeComponent": {
      "type": "object",
      "required": [
        "type",
        "issued_by",
        "immutable",
        "context_id",
        "browser_session_id",
        "component_id",
        "field",
        "action_handle",
        "kind",
        "label",
        "provider_origin",
        "path",
        "runtime_public_key",
        "key_id",
        "expires_at"
      ],
      "properties": {
        "type": { "const": "semreh.native-component.v1" },
        "issued_by": { "const": "browser" },
        "immutable": { "const": true },
        "context_id": { "$ref": "#/$defs/opaqueHandle" },
        "browser_session_id": { "$ref": "#/$defs/opaqueHandle" },
        "component_id": { "$ref": "#/$defs/opaqueHandle" },
        "field": { "$ref": "#/$defs/opaqueHandle" },
        "action_handle": { "$ref": "#/$defs/opaqueHandle" },
        "kind": { "$ref": "#/$defs/componentKind" },
        "label": { "$ref": "#/$defs/safeLabel" },
        "provider_origin": { "$ref": "#/$defs/providerOrigin" },
        "path": { "$ref": "#/$defs/path" },
        "binding": { "$ref": "#/$defs/browserBinding" },
        "runtime_public_key": { "type": "string", "minLength": 32, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
        "key_id": { "$ref": "#/$defs/opaqueHandle" },
        "expires_at": { "$ref": "#/$defs/expiresAt" }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "enum": ["secret", "one_time_code", "recovery_code"] } }
          },
          "then": {
            "properties": {
              "binding": {
                "properties": { "editability": { "const": "editable" } }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "nativeComponentState": {
      "type": "object",
      "required": [
        "type",
        "issued_by",
        "immutable",
        "context_id",
        "browser_session_id",
        "component_id",
        "action_handle",
        "kind",
        "provider_origin",
        "path",
        "status"
      ],
      "properties": {
        "type": { "const": "semreh.native-component-state.v1" },
        "issued_by": { "const": "browser" },
        "immutable": { "const": true },
        "context_id": { "$ref": "#/$defs/opaqueHandle" },
        "browser_session_id": { "$ref": "#/$defs/opaqueHandle" },
        "component_id": { "$ref": "#/$defs/opaqueHandle" },
        "action_handle": { "$ref": "#/$defs/opaqueHandle" },
        "kind": { "$ref": "#/$defs/componentKind" },
        "provider_origin": { "$ref": "#/$defs/providerOrigin" },
        "path": { "$ref": "#/$defs/path" },
        "status": {
          "enum": ["available", "focused", "awaiting_browser", "completed", "cancelled", "blocked", "unavailable"]
        },
        "browser_flow": { "$ref": "#/$defs/browserFlow" },
        "binding": { "$ref": "#/$defs/browserBinding" },
        "cancel_reason": {
          "enum": ["user_cancelled", "browser_cancelled", "expired", "navigation_cancelled"]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "cancelled" } }
          },
          "then": { "required": ["cancel_reason"] }
        }
      ],
      "additionalProperties": false
    },
    "nativeSecretEnvelope": {
      "type": "object",
      "required": [
        "type",
        "issued_by",
        "immutable",
        "context_id",
        "browser_session_id",
        "envelope_id",
        "provider_origin",
        "path",
        "cipher_suite",
        "key_id",
        "client_public_key",
        "nonce",
        "ciphertext",
        "tag",
        "journal_policy"
      ],
      "properties": {
        "type": { "const": "semreh.native-secret-envelope.v1" },
        "issued_by": { "const": "semreh-native" },
        "immutable": { "const": true },
        "context_id": { "$ref": "#/$defs/opaqueHandle" },
        "browser_session_id": { "$ref": "#/$defs/opaqueHandle" },
        "envelope_id": { "$ref": "#/$defs/opaqueHandle" },
        "provider_origin": { "$ref": "#/$defs/providerOrigin" },
        "path": { "$ref": "#/$defs/path" },
        "cipher_suite": { "const": "AES-256-GCM" },
        "key_id": { "$ref": "#/$defs/opaqueHandle" },
        "client_public_key": { "type": "string", "minLength": 32, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
        "nonce": { "type": "string", "minLength": 16, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]+$" },
        "ciphertext": {
          "type": "string",
          "minLength": 16,
          "maxLength": 131072,
          "pattern": "^(?:enc_v1\\.synthetic_placeholder\\.[A-Za-z0-9_-]{16,256}|[A-Za-z0-9_-]{16,131072})$",
          "description": "Opaque authenticated ciphertext; field IDs and values exist only inside it."
        },
        "tag": { "type": "string", "minLength": 16, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
        "journal_policy": { "const": "never" },
        "expires_at": { "$ref": "#/$defs/expiresAt" }
      },
      "additionalProperties": false
    }
  }
}

